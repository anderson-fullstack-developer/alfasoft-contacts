{
  "name": "alfasoft-contacts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node index.js",
    "test": "npm run test:api && npm run test:form && npm run test:functional",
    "dev": "vite",
    "build": "vite build",
    "postinstall": "vite build",
    "test:api": "node --test \"tests/*.test.js\"",
    "test:form": "vitest run",
    "test:functional": "vitest run --config vitest.functional.config.js",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "lint": "eslint ."
  },
  "dependencies": {
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.3",
    "multer": "^2.5.0",
    "mysql2": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "2.4.11",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  }
}
